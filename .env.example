# Copy to .env and edit. This file is shell syntax, not a credential file.
# Load it explicitly: set -a; source .env; set +a
SPIKE_WORK_ROOT=/path/to/work
SPIKE_DATA_ROOT=/path/to/work/datasets/libero
SPIKE_RUN_ROOT=/path/to/work/experiments/spike-turbovla/libero
SPIKE_RUN_NAME=cross_joint_seed42_bs128_3gpu_70k
SPIKE_CUDA_DEVICES=4,5,6

SPIKE_BERT_PATH=/path/to/bert-base-uncased
SPIKE_DINO_PATH=/path/to/dinov3-vitb16
SPIKE_TEXT_PATH=/path/to/smoothspike-bert-base-fused
SPIKE_VISION_CHECKPOINT=/path/to/V3_19.0M_1x4.pth
SPIKE_GROUNDING_CHECKPOINT=/path/to/groundingdino_swint_ogc.pth
SPIKE_TEACHER_CHECKPOINT=/path/to/turbovla_libero.pth
SPIKE_LIBERO_ROOT=/path/to/LIBERO
LIBERO_CONFIG_PATH=/path/to/LIBERO/.libero
