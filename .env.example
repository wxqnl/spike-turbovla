# Shell syntax. Copy to .env and load: set -a; source .env; set +a
# .env is ignored by Git. Do not put credentials in this file.
# This path must be OUTSIDE the source checkout.
SPIKE_WORK_ROOT=/path/to/work

# All paths below have defaults under SPIKE_WORK_ROOT. Uncomment to override.
# SPIKE_DATA_ROOT=/path/to/work/datasets/libero
# SPIKE_RUN_ROOT=/path/to/work/experiments/spike-turbovla/libero
# SPIKE_BERT_PATH=/path/to/work/pretrained/TurboVLA/backbones/bert-base-uncased
# SPIKE_DINO_PATH=/path/to/work/pretrained/TurboVLA/backbones/dinov3-vitb16
# SPIKE_TEXT_PATH=/path/to/work/pretrained/SmoothSpike/smoothspike-bert-base-fused
# SPIKE_VISION_CHECKPOINT=/path/to/work/pretrained/SDT-V3/V3_19.0M_1x4.pth
# SPIKE_GROUNDING_CHECKPOINT=/path/to/work/pretrained/GroundingDINO/groundingdino_swint_ogc.pth
# SPIKE_TEACHER_CHECKPOINT=/path/to/work/pretrained/TurboVLA/checkpoints/libero/turbovla_libero.pth
# SPIKE_LIBERO_ROOT=/path/to/work/benchmarks/LIBERO
# LIBERO_CONFIG_PATH=/path/to/work/benchmarks/LIBERO/.libero

# Presets: ann | vision | vision_text | vision_text_cross
SPIKE_PRESET=vision_text_cross
# Independent overrides (explicit --preset clears these before CLI overrides):
# SPIKE_VISION=sdtv3_19m          # dinov3 | sdtv3_19m
# SPIKE_TEXT=smoothspike_bert     # bert | smoothspike_bert
# SPIKE_CROSS=spike_sdsa         # ann | spike_sdsa

# Prefer --run-name for each new experiment. Without it, the name is derived
# from the resolved modules and training budget. Existing output is never reused.
# SPIKE_RUN_NAME=my_new_experiment
SPIKE_CUDA_DEVICES=4,5,6
SPIKE_BATCH_SIZE=128
SPIKE_GRAD_ACCUM_STEPS=1
SPIKE_MAX_STEPS=70000
SPIKE_SEED=42
SPIKE_EVAL_TRIALS=5             # 5 -> 200 episodes; 50 -> 2000 episodes
